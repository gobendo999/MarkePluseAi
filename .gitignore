# ==============================================================================
# MarketPulse AI - Comprehensive Git Ignore Rules
# ==============================================================================

# 1. Environment Variables & Secret Credentials (CRITICAL - DO NOT COMMIT!)
.env
.env.*
*.env
!.env.example
secrets/

# 2. Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 3. Python Bytecode, Caching & Compiled Files
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# 4. Django & Database
*.sqlite3
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
collected_static/

# 5. Celery & Asynchronous Background Tasks
celerybeat-schedule
celerybeat.pid
*.pid

# 6. Scraping, Playwright & Browser Artifacts
.playwright/
playwright-report/
test-results/
screenshots/
downloads/

# 7. Logs & Debugging
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 8. IDE, Editor & OS Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# 9. Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
